PORT=3000
UPLOADS_DIR=./uploads
DATA_DIR=./data
MAX_FILE_SIZE=5368709120
REQUEST_TIMEOUT_MS=1800000
NODE_ENV=production
VALIDATION_SECRET=vs_from_project_settings
# Requests per minute from one address. The defaults are shown.
# RATE_LIMIT_API=600
# RATE_LIMIT_UPLOAD=120
# RATE_LIMIT_SEARCH=60
# RATE_LIMIT_STORAGE=60
# RATE_LIMIT_PREVIEW=1200
# Changes of the project settings (PATCH /api/settings) per minute from one address.
# RATE_LIMIT_SETTINGS=30
# New API-key checks (keys the server has to ask the platform about) per minute from one address.
# VALIDATION_ATTEMPT_LIMIT=60
# New API-key checks per minute from all addresses together; over it new keys get 503 until the next minute.
# VALIDATION_GLOBAL_LIMIT=300
# Changes of the project settings per minute from all addresses together; over it they get 503 until the next minute.
# SETTINGS_UPDATE_GLOBAL_LIMIT=60
# Failed API-key checks from one address before its new validations are refused, and for how long.
# KEY_FAILURE_LIMIT=20
# KEY_FAILURE_WINDOW_SEC=60
# KEY_FAILURE_BLOCK_SEC=600
# Whose X-Forwarded-For to trust. Default: loopback, linklocal, uniquelocal (nginx on this host,
# Docker's bridge). "false" trusts nothing; a number trusts that many proxy hops. With exactly one
# proxy in front, TRUST_PROXY=1 is the strictest correct setting.
# The limits above count by that header: if this port is reachable directly, not only through your
# proxy, bind it to localhost or set TRUST_PROXY=false.
# TRUST_PROXY=
